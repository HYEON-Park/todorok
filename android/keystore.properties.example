# Release signing config template.
# Copy this file to "keystore.properties" in the same folder (android/) and fill in the values.
#   copy keystore.properties.example keystore.properties
#
# WARNING: Never share or commit keystore.properties or the .keystore/.jks file.
#          If lost, you can NEVER update this app again. Back them up safely.

# Path to the keystore file (relative to android/ folder, or absolute path)
storeFile=todorok-release.keystore
# Keystore (store) password
storePassword=CHANGE_ME_STORE_PASSWORD
# Key alias (the -alias value used when creating the keystore)
keyAlias=todorok
# Key password (usually same as the store password)
keyPassword=CHANGE_ME_KEY_PASSWORD
